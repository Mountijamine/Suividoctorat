<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.devbuild</groupId>
        <artifactId>suividoctorat</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>..</relativePath>
    </parent>
    <artifactId>gateway</artifactId>
    <packaging>jar</packaging>
    <name>gateway</name>

    <dependencies>
        <!-- Use only reactive stack for gateway to avoid servlet-based Spring MVC on classpath -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- Spring Cloud Gateway for HTTP routing (uses discovery locator) -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
        <!-- NOTE: For stable reactive Gateway + Eureka usage, run a dedicated Eureka server module.
             Remove the server dependency here to avoid servlet-based bootstrap conflicts when
             running Spring Cloud Gateway in reactive mode. If you want a combined server/gateway
             in one process, additional servlet-reactor bridging is required (not recommended).
        -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
